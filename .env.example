# Google Gemini API Key (used by the server-side /api/ai/chat endpoint for the
# Product Discovery Assistant — a.k.a. "עוזר חכם"). Never exposed to the client.
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (LEGACY — still used by services/geminiService.ts for recipe
# organization and DALL-E image generation, which currently run client-side).
# Future work will migrate these server-side too.
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Configuration
# Get these from: Firebase Console -> Project Settings -> General -> Your Apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef123456
