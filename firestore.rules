rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lists collection - users can read/write lists where they are members.
    //
    // Slice 4.2c (lista_v2) added the "self-join via share link" branch on
    // `update`: any auth user can append THEIR OWN email to `memberEmails`
    // (and only that field), which unblocks the /share/:listId receiver
    // flow. All other update paths still require existing membership.
    match /lists/{listId} {
      allow read: if request.auth != null &&
        request.auth.token.email in resource.data.memberEmails;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.token.email in resource.data.memberEmails);
      allow update: if request.auth != null && (
        // Owner / existing member — full update authority (current behavior).
        request.auth.uid == resource.data.ownerId ||
        request.auth.token.email in resource.data.memberEmails ||
        // Self-join via share link — only adds caller's own email to
        // `memberEmails`, no other fields touched. Matches the
        // `arrayUnion(self-email)` write performed by `joinSharedList()`.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberEmails']) &&
         request.resource.data.memberEmails.hasAll(resource.data.memberEmails) &&
         request.resource.data.memberEmails.size() == resource.data.memberEmails.size() + 1 &&
         request.auth.token.email in request.resource.data.memberEmails)
      );
    }

    // User profile document — each user can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
    }

    // Saved recipes collection - users can only access their own saved recipes
    match /users/{userId}/saved_recipes/{recipeId} {
      // Only the owner can read, write, update, or delete their saved recipes
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
    }
  }
}
