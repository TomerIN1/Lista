# Google AI / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key

# LLM Model Override
# Default: gemini-2.5-flash
# For Claude via LiteLLM: litellm/anthropic/claude-sonnet-4-20250514
# For GPT: litellm/openai/gpt-4o
LLM_MODEL=gemini-2.5-flash

# PricePilot Server
PRICEPILOT_HOST=0.0.0.0
PRICEPILOT_PORT=8000

# HTTP Client
HTTP_TIMEOUT=15.0
HTTP_MAX_RETRIES=2

# Store: Rami Levy
RAMI_LEVY_STORE_ID=331
RAMI_LEVY_BASE_URL=https://www.rami-levy.co.il
RAMI_LEVY_API_URL=https://www-api.rami-levy.co.il
